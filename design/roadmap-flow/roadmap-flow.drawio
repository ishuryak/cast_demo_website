<mxfile host="app.diagrams.net"><diagram name="Causal roadmap" id="roadmap"><mxGraphModel page="1" pageWidth="720" pageHeight="1000"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="s0" value="&lt;b&gt;01 State the question&lt;/b&gt;&lt;br&gt;Write the target-trial protocol." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3ef;strokeColor=#075d65;fontSize=18;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="80" width="590" height="85" /></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#075d65;" edge="1" parent="1" source="s0" target="s1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s1" value="&lt;b&gt;02 Specify a causal model&lt;/b&gt;&lt;br&gt;Name the causes and the causal effect." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3ef;strokeColor=#075d65;fontSize=18;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="195" width="590" height="85" /></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#075d65;" edge="1" parent="1" source="s1" target="s2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s2" value="&lt;b&gt;03 Examine the data&lt;/b&gt;&lt;br&gt;What is observed, and what is missing?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3ef;strokeColor=#075d65;fontSize=18;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="310" width="590" height="85" /></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#075d65;" edge="1" parent="1" source="s2" target="s3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s3" value="&lt;b&gt;04 Assess identification&lt;/b&gt;&lt;br&gt;Can assumptions connect data to effect?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3ef;strokeColor=#075d65;fontSize=18;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="425" width="590" height="85" /></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#075d65;" edge="1" parent="1" source="s3" target="s4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s4" value="&lt;b&gt;05 Define the statistical target&lt;/b&gt;&lt;br&gt;What quantity in the data will answer it?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3ef;strokeColor=#075d65;fontSize=18;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="540" width="590" height="85" /></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#075d65;" edge="1" parent="1" source="s4" target="s5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s5" value="&lt;b&gt;06 Estimate with uncertainty&lt;/b&gt;&lt;br&gt;Choose methods for that target." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3ef;strokeColor=#075d65;fontSize=18;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="655" width="590" height="85" /></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#075d65;" edge="1" parent="1" source="s5" target="s6"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="s6" value="&lt;b&gt;07 Challenge and interpret&lt;/b&gt;&lt;br&gt;Test sensitivity; state scope and limits." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3ef;strokeColor=#075d65;fontSize=18;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="770" width="590" height="85" /></mxCell><mxCell id="note" value="If support is inadequate, revise the question, assumptions or data.&lt;br&gt;Simplified from Dang and Balzer (2023). doi:10.1097/EDE.0000000000001636" style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="900" width="590" height="85" /></mxCell></root></mxGraphModel></diagram></mxfile>