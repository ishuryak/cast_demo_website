# Normalize line endings so the repo is stable across Windows / WSL / macOS.
* text=auto eol=lf
*.png binary
*.rds binary

# Preserve the byte hashes recorded in the teaching kit's provenance.
tutorial/class-kit/data/*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol
tutorial/data/scenarios.json -text
docs/tutorial/class-kit/data/*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/tutorial/data/scenarios.json -text
